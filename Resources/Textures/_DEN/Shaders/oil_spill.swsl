// light_mode unshaded; // we want lighting to work, which will unfortunately make it not as vibrant.

const highp float PI = 3.14159265;

uniform lowp float scale;
uniform lowp float speed;

highp mat2 rot(highp float t) {
	return mat2(vec2(cos(t), sin(t)), vec2(-sin(t), cos(t)));
}

void fragment() {
    highp vec2 resolution = 1.0 / SCREEN_PIXEL_SIZE;
    highp float mx = max(resolution.x, resolution.y);

    highp vec3 col = vec3(0.0);
    highp vec2 uv = (UV - 0.5) * scale;
    highp float w = fwidth(uv.y);
    highp float d = 1000.0;
    highp float t = TIME * speed;
    highp vec2 p = uv;
    highp vec2 q = uv;
    highp float a = atan(uv.y, uv.x);
    highp float k = length(p);

    col = vec3(1, 2, 3) * 15.0;

    t -= 500.0;
    highp int T = 5;
    for (highp int i = 0; i < T; ++i) {
        p = (sin(p * PI * 2.0 + t * float(i + 1) * 0.03))* 0.5 + 0.5;
        p *= rot(float(i+1) * PI * 2.0 / float(T) - t * 0.3 + k * 5.0);
        col = cross(col.zyx, vec3(p, k));
    }

    // col = normalize(col) * 0.5 + 0.5;
    col = col * 1.2 - 0.2;
    col = pow(col, vec3(1.0 / 2.2));

    highp vec4 tex = texture(TEXTURE, UV);

    COLOR = vec4(col, tex.a);
}