// light_mode unshaded; // we want lighting to work, which will unfortunately make it not as vibrant.

const highp float pi = 3.14159265;

highp mat2 rot(highp float t) {
	return mat2(vec2(cos(t), sin(t)), vec2(-sin(t), cos(t)));
}

highp vec3 hash3(highp float n) {
    return fract(sin(vec3(n, n+1.0, n+2.0)) * vec3(43758.5453123, 22578.1459123, 19642.3490423));
}

highp float mod289(highp float x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

highp vec4 mod289(highp vec4 x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

highp vec4 perm(highp vec4 x) {
    return mod289(((x * 34.0) + 1.0) * x);
}

highp float noise(highp vec3 p) {
    highp vec3 a = floor(p);
    highp vec3 d = p - a;
    d = d * d * (3.0 - 2.0 * d);
    highp vec4 b = a.xxyy + vec4(0.0, 1.0, 0.0, 1.0);
    highp vec4 k1 = perm(b.xyxy);
    highp vec4 k2 = perm(k1.xyxy + b.zzww);
    highp vec4 c = k2 + a.zzzz;
    highp vec4 k3 = perm(c);
    highp vec4 k4 = perm(c + 1.0);
    highp vec4 o1 = fract(k3 * (1.0 / 41.0));
    highp vec4 o2 = fract(k4 * (1.0 / 41.0));
    highp vec4 o3 = o2 * d.z + o1 * (1.0 - d.z);
    highp vec2 o4 = o3.yw * d.x + o3.xz * (1.0 - d.x);
    return o4.y * d.y + o4.x * (1.0 - d.y);
}

const highp mat3 M = mat3(
	 0.74, -0.52,  0.42,
	 0.64,  0.73, -0.23,
	-0.19,  0.45,  0.88
);

highp float fbm(highp vec3 p) {
    highp float f = 0.0;
    f += 0.5000 * noise(p); p *= M * 2.02;
    f += 0.2500 * noise(p); p *= M * 2.03;
    f += 0.1250 * noise(p); p *= M * 2.01;
    f += 0.0625 * noise(p);
    f /= 0.9375;
    return f;
}

highp vec2 fan(highp vec2 p, highp int n) {
    highp float N = float(n);
    highp float a = atan(p.y,p.x);
    a = mod(a, pi * 2.0 / N) - pi/N;
    return length(p) * vec2(cos(a), sin(a));
}

highp float box(highp vec2 p, highp vec2 s) {
    vec2 d = abs(p) - s;
    return min(max(d.x, d.y), 0.0) + length(max(d, 0.0));
}

highp float line( in highp vec2 p, in highp vec2 a, in highp vec2 b ) { // `in` is technically not needed, but let's keep it in for clarity's sake
	highp vec2 pa = p - a;
    highp vec2 ba = b - a;
	highp float h = clamp( dot(pa,ba)/dot(ba,ba), 0.0, 1.0 );
	return length( pa - ba*h );
}


void fragment() {
    highp vec2 resolution = 1.0 / SCREEN_PIXEL_SIZE;
    highp float mx = max(resolution.x, resolution.y);

    highp vec3 col = vec3(0.0);
    highp vec2 uv = (UV - 0.5) * 2.0;
    highp float w = fwidth(uv.y);
    highp float d = 1000.0;
    highp float t = TIME;
    highp vec2 p = uv;
    highp vec2 q = uv;
    highp float a = atan(uv.y, uv.x);
    highp float k = length(p);

    col = vec3(1, 2, 3) * 15.0;

    t -= 500.0;
    highp int T = 5;
    for (highp int i = 0; i < T; ++i) {
        p = (sin(p * pi * 2.0 + t * float(i + 1) * 0.03))* 0.5 + 0.5;
        p *= rot(float(i+1) * pi * 2.0 / float(T) - t * 0.3 + k * 5.0);
        col = cross(col.zyx, vec3(p, k));
    }

    col = normalize(col) * 0.5 + 0.5;
    col = col * 1.2 - 0.2;
    col = pow(col, vec3(1.0 / 2.2));

    highp vec4 tex = texture(TEXTURE, UV);

    COLOR = vec4(col, tex.a);
}